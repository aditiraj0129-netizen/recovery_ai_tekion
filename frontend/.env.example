# Frontend dev settings. Copy to frontend/.env.local only if you need to change them.

# Where the Vite dev server forwards /api/* requests (the FastAPI backend).
VITE_API_TARGET=http://127.0.0.1:8001

# Optional: make the browser call the API directly instead of using the dev proxy.
# The backend's CORS_ORIGINS must then include the frontend address.
# VITE_API_BASE_URL=http://127.0.0.1:8001
